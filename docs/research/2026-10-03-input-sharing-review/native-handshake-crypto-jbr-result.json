    {
      "event": "actual_roundtrip",
      "dummyRoundtrip": true,
      "frameContractMatches": true
    },
    {
      "event": "actual_replay",
      "replayRejected": true
    },
    {
      "event": "cross_transform_exception",
      "checkpoint": "canonical_frame_actual_open",
      "exceptionClass": "java.security.NoSuchAlgorithmException"
    }
  ]
}
