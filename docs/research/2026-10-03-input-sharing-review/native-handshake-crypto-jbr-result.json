{
  "environment": "host AndroidStudio JBR",
  "method": "same dummy-only probe + same exact production Kotlin class",
  "exit": 0,
  "records": [
    {
      "event": "transform_available",
      "algorithm": "ChaCha20-Poly1305",
      "provider": "SunJCE"
    },
    {
      "event": "transform_roundtrip",
      "algorithm": "ChaCha20-Poly1305",
      "dummyRoundtrip": true,
      "tagLengthExpected": true
    },
    {
      "event": "transform_exception",
      "algorithm": "ChaCha20/Poly1305/NoPadding",
