     private fun flushMotion() {
         if (motionX == 0.0 && motionY == 0.0) return
         send(KmWire.payload("move", "dx" to motionX, "dy" to motionY))
         motionX = 0.0; motionY = 0.0
     }
     private fun send(payload: JSONObject) {
