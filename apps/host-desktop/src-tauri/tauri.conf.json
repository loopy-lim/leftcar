{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leftcar Host",
  "version": "0.1.1",
  "identifier": "leftcar.ll3.kr",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Leftcar Host",
        "width": 780,
        "height": 540,
        "minWidth": 640,
        "minHeight": 440,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
