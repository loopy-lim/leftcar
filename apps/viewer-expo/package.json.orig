{
  "name": "@device-hub/main-controller",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Main controller app — Expo / React Native / TypeScript (Expo Development Build).",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "config": "expo config --type public",
    "export:web": "cross-env EXPO_OFFLINE=1 expo export --platform web --output-dir ../desktop-shell/web",
    "export:web:demo": "cross-env EXPO_OFFLINE=1 EXPO_PUBLIC_DEVICE_HUB_DEMO=1 expo export --platform web --output-dir ../desktop-shell/web",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@device-hub/generated-contract": "workspace:*",
    "@device-hub/protocol": "workspace:*",
    "@device-hub/transport": "workspace:*",
    "@expo/metro-runtime": "~57.0.7",
    "expo": "~57.0.0",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-device-stream": "workspace:*",
    "expo-linking": "~57.0.4",
    "expo-modules-core": "~57.0.7",
    "expo-notifications": "~57.0.7",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "3.1.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.11.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.7.0"
  }
}
