{
  "name": "@rustra/react-native",
  "version": "0.4.0",
  "description": "React Native adapter for rustra-bridge",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "utf8.d.ts",
    "utf8.js"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "@rustra/types": "^0.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "rustra",
    "bridge",
    "react-native",
    "adapter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/rustra.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/loopy-lim/rustra/issues"
  },
  "homepage": "https://github.com/loopy-lim/rustra#readme"
}
