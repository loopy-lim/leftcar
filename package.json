{
  "name": "leftcar",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/*/modules/*"
  ],
  "scripts": {
    "dev:host:macos": "zsh tools/dev-host-macos.zsh",
    "check:react-runtime": "bun tools/check-react-runtime-versions.mjs",
    "typecheck": "bun run check:react-runtime && tsc -b && bun run --cwd apps/viewer-expo typecheck && bun run --cwd apps/host-desktop typecheck",
    "test": "vitest run",
    "test:contract": "vitest run -c vitest.contract.config.mts",
    "test:architecture": "bun tools/architecture-check/ts.ts",
    "benchmark:capture": "bun tools/capture-ab-report.ts",
    "rustra:generate": "cargo run -p control-contract --bin generate --locked",
    "doctor": "bun tools/doctor.mjs",
    "build": "bun tools/build.mjs",
    "verify": "bun tools/verify.mjs",
    "test:tooling": "vitest run tools/build.tooling.test.mjs",
    "test:ui": "bun tools/ui-regression/build.mjs && bun tools/ui-regression/all.mjs",
    "setup:browser": "bunx playwright-core install chromium",
    "release:manifest": "bun tools/release-manifest.mjs",
    "release:preflight": "bun tools/release-preflight.mjs",
    "test:gradle-policy": "bun tools/build.gradle-policy.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@xmldom/xmldom": "0.9.12",
    "playwright-core": "1.63.0",
    "semver": "7.8.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
