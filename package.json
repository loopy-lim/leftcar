{
  "name": "leftcar",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/*/modules/*"
  ],
  "scripts": {
    "dev:host:macos": "zsh tools/dev-host-macos.zsh",
    "check:react-runtime": "bun tools/check-react-runtime-versions.mjs",
    "check:ui-theme": "bun tools/generate-ui-theme.ts --check",
    "typecheck": "bun run check:ui-theme && bun run check:react-runtime && tsc -b && bun run --cwd apps/viewer-expo typecheck && bun run --cwd apps/host-desktop typecheck",
    "test": "vitest run",
    "test:contract": "vitest run -c vitest.contract.config.mts",
    "test:architecture": "bun tools/architecture-check/ts.ts",
    "benchmark:capture": "bun tools/capture-ab-report.ts",
    "unikit:generate": "cargo run -p control-contract --bin generate --locked && unikit codegen --config apps/viewer-expo/unikit.json",
    "unikit:check": "unikit codegen --config apps/viewer-expo/unikit.json --check",
    "rustra:generate": "bun run unikit:generate",
    "rustra:check": "bun run unikit:check",
    "doctor": "bun tools/doctor.mjs",
    "build": "bun tools/build.mjs",
    "verify": "bun tools/verify.mjs",
    "test:tooling": "vitest run tools/build.tooling.test.mjs",
    "test:ui": "bun tools/ui-regression/build.mjs && bun tools/ui-regression/all.mjs",
    "setup:browser": "bunx playwright-core install chromium",
    "release:manifest": "bun tools/release-manifest.mjs",
    "release:preflight": "bun tools/release-preflight.mjs",
    "test:gradle-policy": "bun tools/build.gradle-policy.mjs"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@unikit-bridge/cli": "^0.13.0",
    "@unikit-bridge/types": "^0.13.0",
    "@xmldom/xmldom": "0.9.12",
    "playwright-core": "1.63.0",
    "semver": "7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "compression": "1.8.2",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2"
  },
  "patchedDependencies": {
    "react-native-tcp-socket@6.4.2": "patches/react-native-tcp-socket@6.4.2.patch"
  },
  "dependencies": {
    "@unikit-bridge/ui": "0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0"
  }
}
